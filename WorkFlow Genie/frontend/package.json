    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.25",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.1.0",
    "tailwindcss": "^3.3.6",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.4.7"
